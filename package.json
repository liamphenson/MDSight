{
  "name": "mdsight",
  "version": "1.0.0",
  "description": "Lightweight macOS Markdown editor with live preview",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"vite build --watch\" \"sleep 3 && electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "package": "vite build && electron-builder --mac --dir",
    "package:dmg": "vite build && electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.mdsight.app",
    "productName": "MDSight",
    "copyright": "Copyright © 2025 MDSight",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.3",
    "electron": "^42.3.2",
    "electron-builder": "^26.15.3",
    "marked-highlight": "^2.2.4",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.3",
    "chokidar": "^5.0.0",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.4"
  }
}
